# These two domains will be used for traefik labels
EXCALIDRAW_DOMAIN=draw.example.com
COLLAB_DOMAIN=collab.example.com
STORAGE_DOMAIN=storage.example.com

# These two ports are used to port forward your app
FRONTEND_PORT=8080
COLLAB_PORT=8081
STORAGE_PORT=8084

# This is your collab service address. Should contain your
# collab domain and be accessible from the clients.
VITE_APP_WS_SERVER_URL=wss://collab.example.com

# Storage backend URLs (must be accessible from browsers)
VITE_APP_BACKEND_V2_GET_URL=https://storage.example.com/api/v2/
VITE_APP_BACKEND_V2_POST_URL=https://storage.example.com/api/v2/post/

# If you intend to self build the image first
EXCALIDRAW_IMAGE=

# Postgres
POSTGRES_DB=excalidraw
POSTGRES_USER=excalidraw
POSTGRES_PASSWORD=changeme

